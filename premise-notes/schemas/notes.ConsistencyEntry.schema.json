{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "consistency",
  "type": "object",
  "required": [
    "category",
    "established",
    "id",
    "last_confirmed",
    "state",
    "value"
  ],
  "properties": {
    "category": {
      "type": "string"
    },
    "entities": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "entity": {
      "type": [
        "string",
        "null"
      ]
    },
    "established": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "id": {
      "type": "string"
    },
    "last_confirmed": {
      "type": "string"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/definitions/Provenance"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "type": "string"
    },
    "value": {
      "type": "string"
    }
  },
  "definitions": {
    "Provenance": {
      "description": "Per-record provenance details for transparency and repeatability",
      "type": "object",
      "properties": {
        "aliases_applied": {
          "description": "Mapping of alias -> canonical applied during normalization",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "normalization_steps": {
          "description": "Freeform step names for normalization pipeline",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "normalized_with_aliases": {
          "description": "Aliases considered during normalization (canonical names)",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "source_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_line": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0.0
        }
      }
    }
  }
}