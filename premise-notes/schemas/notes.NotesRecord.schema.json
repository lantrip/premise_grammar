{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NotesRecord",
  "anyOf": [
    {
      "$ref": "#/definitions/beat"
    },
    {
      "$ref": "#/definitions/Fact"
    },
    {
      "$ref": "#/definitions/timeline"
    },
    {
      "$ref": "#/definitions/consistency"
    }
  ],
  "definitions": {
    "BeatMetadata": {
      "type": "object",
      "properties": {
        "mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "BeatSource": {
      "type": "string",
      "enum": [
        "llm-generated",
        "manual",
        "imported"
      ]
    },
    "Fact": {
      "type": "object",
      "required": [
        "added",
        "evidence",
        "fact",
        "id",
        "source",
        "type"
      ],
      "properties": {
        "added": {
          "type": "string"
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "entities": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "entity": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fact": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "importance": {
          "anyOf": [
            {
              "$ref": "#/definitions/Importance"
            },
            {
              "type": "null"
            }
          ]
        },
        "importance_assessments": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/Importance"
          }
        },
        "metadata": {
          "anyOf": [
            {
              "$ref": "#/definitions/FactMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/definitions/Provenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/definitions/FactSource"
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeline": {
          "anyOf": [
            {
              "$ref": "#/definitions/Timeline"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "$ref": "#/definitions/FactType"
        }
      }
    },
    "FactMetadata": {
      "type": "object",
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "FactSource": {
      "type": "string",
      "enum": [
        "llm-generated",
        "manual",
        "imported"
      ]
    },
    "FactType": {
      "type": "string",
      "enum": [
        "trait",
        "relationship",
        "knowledge",
        "event",
        "state"
      ]
    },
    "Importance": {
      "type": "object",
      "required": [
        "assessed_by",
        "score",
        "updated"
      ],
      "properties": {
        "assessed_by": {
          "$ref": "#/definitions/ImportanceSource"
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "score": {
          "type": "number",
          "format": "double"
        },
        "updated": {
          "type": "string"
        }
      }
    },
    "ImportanceSource": {
      "type": "string",
      "enum": [
        "user",
        "ai",
        "heuristic"
      ]
    },
    "Provenance": {
      "description": "Per-record provenance details for transparency and repeatability",
      "type": "object",
      "properties": {
        "aliases_applied": {
          "description": "Mapping of alias -> canonical applied during normalization",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "normalization_steps": {
          "description": "Freeform step names for normalization pipeline",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "normalized_with_aliases": {
          "description": "Aliases considered during normalization (canonical names)",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "source_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_line": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0.0
        }
      }
    },
    "Section": {
      "type": "object",
      "properties": {
        "act": {
          "type": [
            "string",
            "null"
          ]
        },
        "cel": {
          "type": [
            "string",
            "null"
          ]
        },
        "scene": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Timeline": {
      "type": "string",
      "enum": [
        "past",
        "present",
        "future"
      ]
    },
    "TimelineOrder": {
      "anyOf": [
        {
          "$ref": "#/definitions/TimelineOrderName"
        },
        {
          "type": "integer",
          "format": "int64"
        }
      ]
    },
    "TimelineOrderName": {
      "type": "string",
      "enum": [
        "past",
        "present",
        "future"
      ]
    },
    "beat": {
      "type": "object",
      "required": [
        "added",
        "entities",
        "file",
        "id",
        "source",
        "text"
      ],
      "properties": {
        "added": {
          "type": "string"
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "file": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "importance": {
          "anyOf": [
            {
              "$ref": "#/definitions/Importance"
            },
            {
              "type": "null"
            }
          ]
        },
        "importance_assessments": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/Importance"
          }
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0.0
        },
        "metadata": {
          "anyOf": [
            {
              "$ref": "#/definitions/BeatMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/definitions/Provenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "section": {
          "anyOf": [
            {
              "$ref": "#/definitions/Section"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/definitions/BeatSource"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "consistency": {
      "type": "object",
      "required": [
        "category",
        "established",
        "id",
        "last_confirmed",
        "state",
        "value"
      ],
      "properties": {
        "category": {
          "type": "string"
        },
        "entities": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "entity": {
          "type": [
            "string",
            "null"
          ]
        },
        "established": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "last_confirmed": {
          "type": "string"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/definitions/Provenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "timeline": {
      "type": "object",
      "required": [
        "added",
        "entities",
        "event",
        "id",
        "order",
        "source"
      ],
      "properties": {
        "added": {
          "type": "string"
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "event": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "order": {
          "$ref": "#/definitions/TimelineOrder"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/definitions/Provenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "relative_to": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}