// Test: Template blocks with role definitions

// Basic template block with typed roles
@template {
  @role Protagonist [character]: The main character who lost something precious
  @role Mentor [character]: A wise figure who guides the protagonist's search
  @role Antagonist [character]: A force or person that blocks or complicates the recovery
  @role MacGuffin [item]: The precious lost object being sought
  @role HomeBase [location]: Where the protagonist starts their journey
  @role Destination [location]: Where the MacGuffin is ultimately found
}

// Template block with roles that lack type hints
@template {
  @role Explorer: The main character who discovers something through experience
  @role Companion: A friend along for the journey who witnesses the discovery
}

// Template block with single role
@template {
  @role Observer [character]: The main character who learns by watching
}

// Empty template block
@template {
}

// Guided template: premise sentence + flagged slot roles
@template {
  @premise: {Person} finds a {LostToy} after searching all of {Location1} and {Location2}.
  @role Person [character, required]: the protagonist who lost something
  @role LostToy [item, required]: the treasured thing that's missing
  @role Location1 [location]: first place searched
  @role Location2 [location, optional]: second place searched
  @role Mood [text]: tone word the child supplies
}

// Multi-sentence premise
@template {
  @premise: {Hero} sets out from {Home}.
  @premise: Along the way {Hero} meets {Friend} and learns about {Lesson}.
  @role Hero [character, required]: protagonist
  @role Home [location]: starting place
  @role Friend [character, optional]: companion met on the journey
  @role Lesson [concept]: what the hero learns
}

// Cardinality flags: count=N..M (with explicit upper, open upper, exact)
@template {
  @premise: {Hero} faces {Trials} across {Stops} and brings home {Lessons}.
  @role Hero    [character, count=1..1]:  protagonist
  @role Trials  [character, count=2..4]:  companions on the road
  @role Stops   [location, count=1..]:    every stop along the way
  @role Lessons [text, count=0..3]:       optional takeaways
  @role Cohort  [character, count=4]:     fixed-size crew (sugar for count=4..4)
}
